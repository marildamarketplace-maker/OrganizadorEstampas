{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "pedido": { "type": "string", "minLength": 1 },
    "data": { "type": "string", "minLength": 1 },
    "clienteCodigo": { "type": "string", "minLength": 1 },
    "clienteNome": { "type": "string", "minLength": 1 },
    "produtos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tecidoCodigo": { "type": "string", "minLength": 1 },
          "tecidoNome": { "type": "string", "minLength": 1 },
          "estampa": { "type": "string", "minLength": 1 },
          "variante": { "type": "string", "minLength": 1 }
        },
        "required": ["tecidoCodigo", "tecidoNome", "estampa", "variante"]
      }
    }
  },
  "required": ["pedido", "data", "clienteCodigo", "clienteNome", "produtos"]
}
